{
  "name": "theralivo-admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "electron": "electron .",
    "dist": "electron-builder"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.102.1",
    "lucide-react": "^1.14.0",
    "next": "16.2.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.10.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "tailwindcss": "^4",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "productName": "Theralivo Admin",
  "description": "Theralivo admin panel",
  "main": "main.js",
  "build": {
    "appId": "gr.theralivo.admin",
    "productName": "Theralivo Admin",
    "files": [
      "**/*",
      "!.next/**",
      "!dist/**",
      "!src/**",
      "!public/**",
      "!physiohome-admin-desktop/**",
      "!**/*.md",
      "!.git*"
    ],
    "win": {
      "icon": "build/app-icon.ico",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "shortcutName": "Theralivo Admin"
    }
  }
}